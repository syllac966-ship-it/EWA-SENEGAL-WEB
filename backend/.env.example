# Serveur
NODE_ENV=development
PORT=4000
# Une ou plusieurs origines autorisées, séparées par des virgules
CORS_ORIGIN=http://localhost:5173

# Base de données PostgreSQL
DATABASE_URL=postgresql://ewa_user:ewa_password@localhost:5432/ewa_senegal

# Auth JWT (générer une valeur forte et unique en production, ex: openssl rand -hex 64)
JWT_SECRET=change_me_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=8h

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Règles métier
ADVANCE_CAP_PERCENT=50
